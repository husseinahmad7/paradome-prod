# Copy to .env for local development, or to a mode-0600 file outside the
# checkout for production. Values are intentionally blank; never commit them.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:8000

DB_HOST=db
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=  # gitleaks:allow -- intentionally blank placeholder
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
CONTACT_RECIPIENT=

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

DEMO_ACCOUNT_ENABLED=true
DEMO_USERNAME=paradome-demo
PRIVATE_MEDIA_ROOT=/app/private_media

CACHE_TABLE=paradome_cache
CACHE_TIMEOUT=300
CACHE_MAX_ENTRIES=10000
SECURE_HSTS_SECONDS=31536000

MYSQL_ROOT_PASSWORD=
